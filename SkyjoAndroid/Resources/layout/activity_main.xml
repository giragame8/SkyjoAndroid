<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1e272e"
    android:padding="10dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ADVERSAIRE (IA)"
        android:textColor="#e74c3c"
        android:textStyle="bold"
        android:layout_marginBottom="10dp"/>

    <!-- Grille Adversaire -->
    <GridLayout
        android:id="@+id/grilleAdversaire"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="3"/>

    <!-- Pioche et Défausse -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginVertical="20dp">

        <Button
            android:id="@+id/btnPioche"
            android:layout_width="80dp"
            android:layout_height="120dp"
            android:text="Pioche\n(Dos)"
            android:backgroundTint="#34495e"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="20dp"/>

        <Button
            android:id="@+id/btnDefausse"
            android:layout_width="80dp"
            android:layout_height="120dp"
            android:text="?"
            android:textStyle="bold"
            android:textSize="24sp"
            android:backgroundTint="#ecf0f1"
            android:textColor="#2c3e50"/>
    </LinearLayout>

    <!-- Grille Joueur -->
    <GridLayout
        android:id="@+id/grilleJoueur"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="3"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VOUS"
        android:textColor="#2ecc71"
        android:textStyle="bold"
        android:layout_marginTop="10dp"/>

</LinearLayout>